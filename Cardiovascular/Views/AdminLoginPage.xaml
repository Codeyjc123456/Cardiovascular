<Page
    x:Class="Cardio.Views.AdminLoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AdminLoginPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CenteredPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Image/Common/background_a.png" Stretch="Fill" />
    </Page.Background>

    <hc:TransitioningContentControl TransitionMode="Fade">

        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="360" />
                        <RowDefinition Height="455" />
                        <RowDefinition Height="265" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1">
                        <TextBox
                            x:Name="UserIdBtn"
                            Width="618"
                            Height="92"
                            Margin="140,118,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            FontSize="42"
                            TextAlignment="Center">
                            <TextBox.Text>
                                <Binding
                                    NotifyOnValidationError="True"
                                    Path="UserID"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules />
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="IDInfo"
                            Width="618"
                            Height="15"
                            Margin="115,10,0,0"
                            FontSize="12"
                            Foreground="Red"
                            Text="" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <PasswordBox
                            x:Name="UserPWD"
                            Grid.Row="0"
                            Width="618"
                            Height="92"
                            Margin="115,-250,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            FontSize="42"
                            LostFocus="PasswordBox_LostFocus"
                            PasswordChar="*"
                            Style="{StaticResource CenteredPasswordBoxStyle}" />
                        <TextBlock
                            x:Name="PWDInfo"
                            Width="618"
                            Height="15"
                            Margin="115,-130,0,0"
                            FontSize="12"
                            Foreground="Red"
                            Text="" />
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="1">
                    <Button
                        Click="CloseBtn"
                        Content="退出"
                        DockPanel.Dock="Left"
                        Style="{StaticResource IconBigBlueBtn}"
                        Tag="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32v224c0 17.7 14.3 32 32 32s32-14.3 32-32V32zm-144.5 88.6c13.6-11.3 15.4-31.5 4.1-45.1s-31.5-15.4-45.1-4.1C49.7 115.4 16 181.8 16 256c0 132.5 107.5 240 240 240s240-107.5 240-240c0-74.2-33.8-140.6-86.6-184.6-13.6-11.3-33.8-9.4-45.1 4.1s-9.4 33.8 4.1 45.1c38.9 32.3 63.5 81 63.5 135.4 0 97.2-78.8 176-176 176s-176-78.8-176-176c0-54.4 24.7-103.1 63.5-135.4z" />

                    <Button
                        Margin="1200,0,0,0"
                        Click="LoginBtn"
                        Content="登录"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconBigBlueBtn}"
                        Tag="m217.9 105.9 122.8 122.8c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L217.9 406.1c-6.4 6.4-15 9.9-24 9.9-18.7 0-33.9-15.2-33.9-33.9V320H32c-17.7 0-32-14.3-32-32v-64c0-17.7 14.3-32 32-32h128v-62.1c0-18.7 15.2-33.9 33.9-33.9 9 0 17.6 3.6 24 9.9zM352 416h64c17.7 0 32-14.3 32-32V128c0-17.7-14.3-32-32-32h-64c-17.7 0-32-14.3-32-32s14.3-32 32-32h64c53 0 96 43 96 96v256c0 53-43 96-96 96h-64c-17.7 0-32-14.3-32-32s14.3-32 32-32z" />
                </DockPanel>
            </Grid>

            <!--  全屏蒙板层 - 覆盖整个窗口  -->
            <Grid x:Name="overlayGrid" Style="{StaticResource FullScreenOverlayStyle}">
                <!--  加载指示器容器  -->
                <Border Style="{StaticResource LoadingContainerStyle}">
                    <StackPanel
                        Height="150"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                        <!--  进度条  -->
                        <ProgressBar
                            x:Name="progressBar"
                            Width="1000"
                            Height="50"
                            Margin="0,50,0,50"
                            Foreground="#2d90dc"
                            Maximum="100"
                            Minimum="0" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

    </hc:TransitioningContentControl>
</Page>
