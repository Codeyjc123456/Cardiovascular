<Page
    x:Class="CardioVascular.Views.SystemPage.DebugSetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Cardio.CustomRule"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views.SystemPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Cardio.Model"
    xmlns:r="clr-namespace:Cardio.CustomConvert"
    xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="DebugSetPage"
    d:DesignHeight="1008"
    d:DesignWidth="1720"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <r:CheckConverter x:Key="CheckConverter" />
    </Page.Resources>

    <hc:TransitioningContentControl TransitionMode="Fade">
        <StackPanel
            Width="1720"
            Height="1008"
            Orientation="Vertical">
            <StackPanel Height="888" Orientation="Horizontal">
                <StackPanel Width="860">
                    <hc:Card Style="{StaticResource CustomCard}">
                        <StackPanel Margin="10,10,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="BPStart"
                                    Height="50"
                                    Margin="10,0,0,0"
                                    Click="cmdStartPressMrs_Click"
                                    Content="血压测量"
                                    Style="{StaticResource BigBlueBtnStyle}" />

                                <Button
                                    Height="50"
                                    Click="cmdGetPressResult_Click"
                                    Content="读取结果"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                            </StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="100"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="收缩压：" />
                                <TextBox Style="{StaticResource CustomSmallShortTextBox}" Text="{Binding SBP}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="舒张压：" />
                                <TextBox Style="{StaticResource CustomSmallShortTextBox}" Text="{Binding DBP}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="平均压：" />
                                <TextBox Style="{StaticResource CustomSmallShortTextBox}" Text="{Binding MAP}" />
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="100"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="脉搏：" />
                                <TextBox Style="{StaticResource CustomSmallShortTextBox}" Text="{Binding BPHr}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="实时压力：" />
                                <TextBox Style="{StaticResource CustomSmallShortTextBox}" Text="{Binding RealPressure}" />


                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="120"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="返回代码：" />
                                <TextBox
                                    Width="120"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding ReturnCode}" />
                            </StackPanel>
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="血压测量控制" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    <hc:Card Style="{StaticResource CustomCard}">
                        <StackPanel Margin="0,10,10,10" Orientation="Horizontal">
                            <StackPanel
                                Margin="10,20,20,20"
                                VerticalAlignment="Top"
                                Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="10"
                                        Style="{StaticResource CustomMedianTextBlock}"
                                        Text="预期压力：" />
                                    <TextBox
                                        Margin="10,15,10,10"
                                        Style="{StaticResource CustomSmallShortTextBox}"
                                        Text="{Binding Pressure}" />

                                </StackPanel>
                                <Button
                                    Margin="80,10,0,10"
                                    Click="cmdSetting_Click"
                                    Content="设定预期压力"
                                    Style="{StaticResource BigGreenBtnStyle}" />
                            </StackPanel>
                            <StackPanel Margin="20" Orientation="Vertical">
                                <Button
                                    Margin="10"
                                    Click="cmdCloseValve_Click"
                                    Content="关闭阀门"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                                <Button
                                    Margin="10"
                                    Click="cmdOpenValve_Click"
                                    Content="打开阀门"
                                    Style="{StaticResource BigBlueBtnStyle}" />

                            </StackPanel>
                            <StackPanel Margin="20" Orientation="Vertical">
                                <Button
                                    x:Name="PreStart"
                                    Margin="10"
                                    Click="StartTime_Click"
                                    Content="压力检测"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                                <Button
                                    Width="160"
                                    Height="50"
                                    Margin="10"
                                    Click="Save_Click"
                                    Content="保存"
                                    Style="{StaticResource BigOrangeBtnStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" Orientation="Vertical">
                                <TextBox
                                    Margin="0,10,10,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding APP_CorSbp}" />
                                <TextBox
                                    Margin="0,10,10,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding APP_CorDbp}" />
                                <TextBox
                                    Margin="0,10,10,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding APP_CorHr}" />
                                <TextBox
                                    Margin="0,10,10,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding APP_CorMap}" />
                            </StackPanel>
                        </StackPanel>
                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="压力校准" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    <hc:Card Height="290" Style="{StaticResource CustomCard}">
                        <Border CornerRadius="4">
                            <ListBox
                                x:Name="TipsMsg"
                                Width="840"
                                Margin="5"
                                HorizontalAlignment="Center"
                                ManipulationBoundaryFeedback="ManipulationBoundaryFeedback">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontFamily="SimSun"
                                            FontSize="20"
                                            Text="{Binding Path=Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsSource>
                                    <Binding Path="TipsPPGList" />
                                </ListBox.ItemsSource>
                            </ListBox>
                        </Border>
                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="指令信息" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                </StackPanel>
                <StackPanel Width="860">
                    <hc:Card Grid.Row="0" Style="{StaticResource CustomCard}">
                        <StackPanel Margin="10,10,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="PWVBtn"
                                    Width="160"
                                    Margin="10"
                                    Click="cmdStartPulseMrs_Click"
                                    Content="开始采集"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                                <Button
                                    Height="50"
                                    Margin="10"
                                    Click="cmdIncGain_Click"
                                    Content="上调增益"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                                <Button
                                    Height="50"
                                    Margin="10"
                                    Click="cmdDecGain_Click"
                                    Content="下调增益"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                                <Button
                                    Height="50"
                                    Margin="10"
                                    Click="ProcessRp_Click"
                                    Content="计算心率"
                                    Style="{StaticResource BigBlueBtnStyle}" />
                            </StackPanel>
                            <!--<StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="140"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="HR(次/分)：" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding HR}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="ED:" />
                                <TextBox
                                    Width="100"
                                    Margin="00,0,0,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding ED}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="SPTI:" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding SPTI}" />
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="140"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="DPTI：" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding Dpti}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="SEVER：" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding Sever}" />
                            </StackPanel>-->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="150"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="心率(次/分)：" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding DebugHR}" />

                                <TextBlock
                                    Width="150"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="周期(毫秒):" />
                                <TextBox
                                    Width="100"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding Period}" />
                            </StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Width="140"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="采样时间：" />
                                <TextBox
                                    Width="100"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding Number}" />

                                <TextBlock
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="频率：" />
                                <TextBox
                                    Width="100"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource CustomSmallShortTextBox}"
                                    Text="{Binding Rate}" />

                            </StackPanel>
                        </StackPanel>
                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="桡动脉测量控制" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    <hc:Card Style="{StaticResource CustomCard}">
                        <Border
                            Width="800"
                            Height="515"
                            Margin="10"
                            Style="{StaticResource CustomBorder}">

                            <scottplot:WpfPlot
                                x:Name="zg_ai"
                                Width="780"
                                Height="380" />
                        </Border>
                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="桡动脉波形展示" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <hc:Card Style="{StaticResource CustomCard}">
                    <Button
                        Margin="10"
                        HorizontalAlignment="Right"
                        Click="SaveBtn"
                        Content="保 存"
                        Style="{StaticResource IconBigBlueBtn}"
                        Tag="M64 32C28.7 32 0 60.7 0 96v320c0 35.3 28.7 64 64 64h320c35.3 0 64-28.7 64-64V173.3c0-17-6.7-33.3-18.7-45.3L352 50.7c-12-12-28.3-18.7-45.3-18.7H64zm0 96c0-17.7 14.3-32 32-32h192c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32v-64zm160 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128z" />

                </hc:Card>
            </StackPanel>
        </StackPanel>
    </hc:TransitioningContentControl>
</Page>
