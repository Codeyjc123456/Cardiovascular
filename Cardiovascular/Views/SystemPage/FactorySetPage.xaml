<Page
    x:Class="Cardio.Views.SystemPage.FactorySetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Cardio.CustomRule"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views.SystemPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Cardio.Model"
    xmlns:r="clr-namespace:Cardio.CustomConvert"
    Title="FactorySetPage"
    d:DesignHeight="980"
    d:DesignWidth="1840"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <r:CheckConverter x:Key="CheckConverter" />
    </Page.Resources>
    <hc:TransitioningContentControl TransitionMode="Fade">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="880" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="360" />
                        <RowDefinition Height="300" />
                    </Grid.RowDefinitions>

                    <hc:Card Grid.Row="0" Style="{StaticResource CustomCard}">

                        <StackPanel Margin="30,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="调试密码：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}" Text="{Binding APP_PWD}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CustomSmallTips}" Text="Tips：不填则默认没有密码，此密码用于打开调式界面和工厂测试界面权限校验" />
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="密码设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>

                    <hc:Card Grid.Row="1" Style="{StaticResource CustomCard}">
                        <StackPanel Margin="30,20,0,0">
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="血压脉搏波串口：" />
                                <ComboBox
                                    x:Name="BPCOM"
                                    SelectedItem="{Binding APP_BPPort, Mode=TwoWay}"
                                    Style="{StaticResource CustomMedianComBox}" />
                            </StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="采样频率：" />
                                <TextBox
                                    x:Name="COMRate"
                                    Width="250"
                                    Margin="70,0,0,0"
                                    Style="{StaticResource CustomMedianLongTextBox}"
                                    Text="{Binding APP_COMRate, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="串口设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>

                    <hc:Card Grid.Row="2" Style="{StaticResource CustomCard}">

                        <StackPanel Margin="30,20,0,0">
                            <!--<StackPanel Orientation="Horizontal">
                            -->
                            <!--<TextBlock
                                    Width="100"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="版本号：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}" Text="{Binding-->
                            <!-- APP_Version}" />
                            </StackPanel>-->

                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Width="100"
                                    Style="{StaticResource CustomMedianTextBlock}"
                                    Text="型号：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}" Text="{Binding APP_Type}" />
                            </StackPanel>

                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="版本设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="270" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <hc:Card Grid.Row="0" Style="{StaticResource CustomCard}" />

                    <hc:Card Grid.Row="1" Style="{StaticResource CustomCard}" />
                </Grid>
            </Grid>

            <Button
                Grid.Row="1"
                Margin="0,10,40,0"
                HorizontalAlignment="Right"
                Click="SaveBtn"
                Content="保 存"
                Style="{StaticResource IconBigBlueBtn}"
                Tag="M64 32C28.7 32 0 60.7 0 96v320c0 35.3 28.7 64 64 64h320c35.3 0 64-28.7 64-64V173.3c0-17-6.7-33.3-18.7-45.3L352 50.7c-12-12-28.3-18.7-45.3-18.7H64zm0 96c0-17.7 14.3-32 32-32h192c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32v-64zm160 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128z" />
        </Grid>
    </hc:TransitioningContentControl>
</Page>
