<Window x:Class="Cardio.Views.SystemPage.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputBox" Height="175.945" Width="350"
        Loaded="Window_Loaded"
        WindowStyle="SingleBorderWindow"
        >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="319*"/>
            <ColumnDefinition Width="31*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptTextBlock" Margin="10,10,10,10" TextWrapping="Wrap" Text="请输入密码:" Grid.ColumnSpan="2"/>
        <PasswordBox x:Name="InputTextBox" Margin="10,10,10,10" Grid.Row="1" PasswordChar="*" Grid.ColumnSpan="2" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="180,10,0,10" Grid.Row="2" Grid.ColumnSpan="2">
            <Button x:Name="OkButton" Content="确认" Width="70" Margin="5" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="70" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
