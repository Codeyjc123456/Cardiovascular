<Page
    x:Class="Cardio.Views.SystemPage.ParameterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views.SystemPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="clr-namespace:Cardio.CustomConvert" xmlns:r1="clr-namespace:Cardio.CustomRule"
    Title="FactoryPage"
    d:DesignHeight="880"
    d:DesignWidth="1840"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <r:CheckConverter x:Key="CheckConverter" />
    </Page.Resources>
    <hc:TransitioningContentControl TransitionMode="Fade">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="190" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <!--  报表设置  -->
                    <hc:Card
                        Grid.Row="0"
                        Style="{StaticResource CustomCard}">
                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="DataType：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"  Text="{Binding APP_dataType}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="CheckNo：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}" Text="{Binding APP_checkNo}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="Doctor：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}" Text="{Binding APP_checkDoctor}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="Department：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"  Text="{Binding APP_checkDepartment}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="Time：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"  Text="{Binding APP_checkTime}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="deviceModel：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"  Text="{Binding APP_deviceModel}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="Result：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"   Text="{Binding APP_checkResult}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="ResultText：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"   Text="{Binding APP_checkResultText}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock2}" Text="manufacturer：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}"  Text="{Binding APP_manufacturer}" />
                            </StackPanel>

                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="传参设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    

                    <!--  报表设置  -->
                    <hc:Card
                        Grid.Row="1"
                        Style="{StaticResource CustomCard}">

                        <StackPanel Margin="30,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="报表表头：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox}">
                                    <TextBox.Text>
                                        <Binding NotifyOnValidationError="True" Path="APP_CompaneTitle" UpdateSourceTrigger="LostFocus">

                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CustomSmallTips}" Text="Tips：该信息会显示在报表表头" />
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="报表设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    <!--  打印设置  -->
                    <hc:Card Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomCard}">
                        <StackPanel Margin="30,0,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="选择默认打印机：" />
                            <ComboBox x:Name="PrinterCom" SelectedItem="{Binding APP_Printer, Mode=TwoWay}"  Style="{StaticResource CustomMedianComBox}" />
                            <RadioButton Margin="30,10,10,10" Content="关闭对话框" IsChecked="{Binding APP_PrinterDialog, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='关闭'}" Style="{StaticResource CustomMedianRadioButton}" />
                            <RadioButton Content="打开" IsChecked="{Binding APP_PrinterDialog, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='打开'}" Style="{StaticResource CustomMedianRadioButton}" />
                        </StackPanel>
                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="打印设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                    
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300" />
                        <RowDefinition Height="400" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <hc:Card Grid.Row="0" Style="{StaticResource CustomCard}">

                        <StackPanel Margin="10,10,10,10" Orientation="Horizontal">
                            <RadioButton Margin="10,10,10,10" Content="单机版" FontSize="32" IsChecked="{Binding APP_Network, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='单机版'}" />
                            <RadioButton Margin="10,10,10,10" Content="网络版" FontSize="32" IsChecked="{Binding APP_Network, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='网络版'}" />
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="版本设置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>

                    <hc:Card Grid.Row="1" Style="{StaticResource CustomCard}">
                        <StackPanel  Margin="20,100,10,10">

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="登录接口：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox2}"  Text="{Binding APP_ApiUrlLogin}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="数据接口：" />
                                <TextBox Style="{StaticResource CustomMedianLongTextBox2}"  Text="{Binding APP_ApiUrlData}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource CustomMedianTextBlock}" Text="数据上传：" />
                                <RadioButton
                                            Margin="10,10,10,10"
                                            Content="自动"
                                            FontSize="24"
                                            IsChecked="{Binding APP_AutoUpload, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='自动'}" />
                                <RadioButton
                                            Margin="10,10,10,10"
                                            Content="手动"
                                            FontSize="24"
                                            IsChecked="{Binding APP_AutoUpload, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='手动'}" />
                            </StackPanel>
                            
                        </StackPanel>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="API接口参数配置" />
                            </StackPanel>
                        </hc:Card.Header>
                    </hc:Card>
                </Grid>

            </Grid>

            <Button  Grid.Row="1" Margin="0,0,40,0" HorizontalAlignment="Right" Click="SaveBtn"   Content="保 存"
  Style="{StaticResource IconBigBlueBtn}"
  Tag="M64 32C28.7 32 0 60.7 0 96v320c0 35.3 28.7 64 64 64h320c35.3 0 64-28.7 64-64V173.3c0-17-6.7-33.3-18.7-45.3L352 50.7c-12-12-28.3-18.7-45.3-18.7H64zm0 96c0-17.7 14.3-32 32-32h192c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32v-64zm160 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/>

        </Grid>
    </hc:TransitioningContentControl>
</Page>
