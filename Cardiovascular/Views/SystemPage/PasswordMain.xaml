<Window
    x:Class="Cardio.Views.SystemPage.PasswordMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PasswordMain"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    ResizeMode ="NoResize"
    Left="285" Top="82"
    Height="1000"
    Width="1635"
    mc:Ignorable="d">
    <hc:TransitioningContentControl >
        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="250 "/>
                <RowDefinition Height="250" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="418"/>
                <ColumnDefinition Width="418"/>
                <ColumnDefinition Width="418"/>
                <ColumnDefinition Width="418"/>
            </Grid.ColumnDefinitions>
            <TextBlock  Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Margin="0,87,104,0" Text="请输入密码:" FontSize="30" Width="162"/>
            <PasswordBox Grid.Column="1" Grid.Row="1" x:Name="passwordBox" Margin="358,74,138,108"  FontSize="30" Grid.ColumnSpan="2"/>
            <Button Grid.Column="1" Grid.Row="2" FontSize="30"
                    Width="130"
                    HorizontalAlignment="Center"
                    Click="Button_Click"
                    Content="确认" Margin="253,52,36,132" Height="66" />
            <Button 
                    Width="118" Grid.Column="2" Grid.Row="2" FontSize="30"
                    HorizontalAlignment="Center"
                    Click="Button_Cancle_Click"
                    Content="取消" Height="66" Margin="40,52,261,132"/>
        </Grid>
    </hc:TransitioningContentControl>

</Window>
