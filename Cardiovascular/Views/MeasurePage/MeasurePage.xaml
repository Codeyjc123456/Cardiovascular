<Page
    x:Class="Cardio.Views.MeasurePage.MeasureReePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views.MeasurePage"
    xmlns:local1="clr-namespace:Cardio.Model"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="MeasureReePage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Page.Background>
        <ImageBrush ImageSource="/Resources/Image/Measure/testback.png" Stretch="Fill" />
    </Page.Background>
    <hc:TransitioningContentControl TransitionStoryboard="{StaticResource FadeTransition}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="144" />
                <RowDefinition Height="845" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Orientation="Vertical">
                    <Button
                        x:Name="BackButton"
                        Height="72"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="BackBtn">
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Image Source="pack://application:,,,/Resources/Image/Common/back.png" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Height="72" Orientation="Horizontal">
                        <TextBlock
                            Width="289"
                            Height="52"
                            Margin="104.6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            Text="{Binding UserName}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="411"
                            Height="52"
                            Margin="116.6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            Text="{Binding UserID}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="162"
                            Height="52"
                            Margin="116.6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            Text="{Binding UserSex}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="226"
                            Height="52"
                            Margin="116.6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            Text="{Binding BirthDay}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="226"
                            Height="52"
                            Margin="116.6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            Text="{Binding UserHeight}"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <hc:LoadingCircle
                Grid.Row="2"
                Margin="940,1,940,0"
                VerticalAlignment="Top"
                Visibility="{Binding IsRunning}" />
            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="338" />
                    <RowDefinition Height="372" />
                    <RowDefinition Height="144" />
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <Grid Grid.Column="0">
                    <Grid Margin="30,60,30,20" Visibility="Visible">
                        <scottplot:WpfPlot x:Name="AiSeries" Panel.ZIndex="9999" />
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="950" />
                        <ColumnDefinition Width="972" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Name="Hr"
                                Width="75"
                                Height="40"
                                Margin="370,126,0,0"
                                HorizontalAlignment="Left"
                                FontSize="28"
                                Foreground="#0A80C6 "
                                Text="{Binding Hr}"
                                TextAlignment="Center" />
                            <TextBlock
                                Width="15"
                                Height="27"
                                Margin="0,-40,43,0">
                                <Image Name="Hrup" Source="{Binding HrUp}" />
                            </TextBlock>
                            <TextBlock
                                Name="EdPct"
                                Width="75"
                                Height="40"
                                Margin="370,11,0,0"
                                HorizontalAlignment="Left"
                                FontSize="28"
                                Foreground="#0A80C6 "
                                Text="{Binding EdPct}"
                                TextAlignment="Center" />
                            <TextBlock
                                Width="15"
                                Height="27"
                                Margin="0,-40,43,0">
                                <Image Name="Edup" Source="{Binding EdUp}" />
                            </TextBlock>
                            <TextBlock
                                Name="Spti"
                                Width="75"
                                Height="40"
                                Margin="370,11,0,0"
                                HorizontalAlignment="Left"
                                FontSize="28"
                                Foreground="#0A80C6"
                                Text="{Binding Spti}"
                                TextAlignment="Center" />
                            <TextBlock
                                Width="15"
                                Height="27"
                                Margin="0,-40,43,0">
                                <Image Name="Sptiup" Source="{Binding SptiUp}" />
                            </TextBlock>
                            <TextBlock
                                Name="Dpti"
                                Width="75"
                                Height="40"
                                Margin="370,11,0,0"
                                HorizontalAlignment="Left"
                                FontSize="28"
                                Foreground="#0A80C6 "
                                Text="{Binding Dpti}"
                                TextAlignment="Center" />
                            <TextBlock
                                Width="15"
                                Height="27"
                                Margin="0,-40,43,0">
                                <Image Name="Dptiup" Source="{Binding DptiUp}" />
                            </TextBlock>
                            <TextBlock
                                x:Name="lblSevr"
                                Width="75"
                                Height="40"
                                Margin="370,11,0,0"
                                HorizontalAlignment="Left"
                                FontSize="28"
                                Foreground="#0A80C6"
                                Text="{Binding Sevr}"
                                TextAlignment="Center" />
                            <TextBlock
                                Width="15"
                                Height="27"
                                Margin="0,-40,43,0">
                                <Image Name="Sevrup" Source="{Binding SevrUp}" />
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Vertical" />
                        <TextBlock
                            x:Name="SBP"
                            Width="75"
                            Height="40"
                            Margin="375,126,0,0"
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Foreground="#0a80c6"
                            Text="{Binding Sbp}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="15"
                            Height="27"
                            Margin="0,-38,55,0">
                            <Image Name="SBpup" Source="{Binding SBpUp}" />
                        </TextBlock>

                        <TextBlock
                            x:Name="DBP"
                            Width="75"
                            Height="40"
                            Margin="375,11,0,0"
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Foreground="#0a80c6"
                            Text="{Binding Dbp}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="15"
                            Height="27"
                            Margin="0,-38,55,0">
                            <Image Name="DBpup" Source="{Binding DBpUp}" />
                        </TextBlock>

                        <TextBlock
                            x:Name="PP"
                            Width="75"
                            Height="40"
                            Margin="375,11,0,0"
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Foreground="#0a80c6"
                            Text="{Binding Pp}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="15"
                            Height="27"
                            Margin="0,-38,55,0">
                            <Image Name="Ppup" Source="{Binding PpUp}" />
                        </TextBlock>

                        <TextBlock
                            x:Name="Cap"
                            Width="75"
                            Height="40"
                            Margin="375,11,0,0"
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Foreground="#0a80c6"
                            Text="{Binding Cap}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="15"
                            Height="27"
                            Margin="0,-38,55,0">
                            <Image Name="SBp2up" Source="{Binding CapUp}" />
                        </TextBlock>

                        <TextBlock
                            x:Name="AIx"
                            Width="75"
                            Height="40"
                            Margin="375,10,0,0"
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Foreground="#0a80c6"
                            Text="{Binding AIx}"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="15"
                            Height="27"
                            Margin="0,-38,55,0">
                            <Image Name="AIxup" Source="{Binding AIxUp}" />
                        </TextBlock>

                    </StackPanel>

                </Grid>
                <Grid Grid.Row="2">
                    <TextBlock
                        Width="65"
                        Height="32"
                        Margin="150,10,0,0"
                        HorizontalAlignment="Left"
                        FontSize="28"
                        Foreground="#0A80C6 "
                        Text="{Binding Dbp}"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="69"
                        Height="32"
                        Margin="470,10,0,0"
                        HorizontalAlignment="Left"
                        FontSize="28"
                        Foreground="#0A80C6 "
                        Text="{Binding Sbp}"
                        TextAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="1100,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ProgressBar
                            Width="770"
                            Height="60"
                            Margin="10,0,0,0"
                            Background="#DEE7EE"
                            FontSize="28"
                            Foreground="#FF2491E6"
                            Style="{StaticResource ProgressBarSuccess}"
                            Value="{Binding TestStatus}" />
                    </StackPanel>

                </Grid>
                <Image
                    Name="Ready"
                    Grid.RowSpan="3"
                    Margin="0,0,0,10"
                    Source="{Binding Ready}" />
            </Grid>

            <Grid Grid.Row="3">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <StackPanel>
                        <Label
                            Width="1000"
                            Height="70"
                            Margin="10"
                            HorizontalContentAlignment="Left"
                            Content="{Binding Tips}"
                            FontSize="26" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Grid HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="OpenReport"
                                Grid.Column="0"
                                Width="200"
                                Height="65"
                                Margin="0,0,0,0"
                                Click="Commit_Click"
                                Content=" 打印报告"
                                Style="{StaticResource BigBlueBtnStyle}" />


                            <Button
                                x:Name="AITest"
                                Grid.Column="1"
                                Width="200"
                                Height="65"
                                Margin="0,0,0,0"
                                Click="Pic_AI_test_Click"
                                Content="心血管测试"
                                Style="{StaticResource BigBlueBtnStyle}" />
                            <Button
                                x:Name="TestBtn"
                                Grid.Column="2"
                                Width="200"
                                Height="65"
                                Margin="0,0,0,0"
                                Click="Pic_test_Click"
                                Content="开始测量"
                                Style="{StaticResource BigBlueBtnStyle}" />
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </hc:TransitioningContentControl>
</Page>
