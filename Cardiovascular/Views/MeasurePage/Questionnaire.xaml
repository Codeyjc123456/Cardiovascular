<Border x:Class="Cardio.Views.MeasurePage.Questionnaire"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cardio.Views.MeasurePage"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="620" 
      d:DesignWidth="900"
      Width="900" Height="620"
      Background="White"
      CornerRadius="10"
      Loaded="Border_Load">

    <Grid Margin="40,30,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--标题-->
        <TextBlock
            Grid.Row="0"
            Text="健康问卷"
            FontSize="34"
            FontWeight="Bold"
            Foreground="#0A80C6"
            HorizontalAlignment="Center"
            Margin="0,0,0,24"/>

        <!--危险因素-->
        <StackPanel Grid.Row="1" Margin="0,0,0,22">
            <TextBlock Text="心血管危险因素" FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,12"/>
            <UniformGrid Columns="4">
                <CheckBox Content="吸烟" FontSize="22" IsChecked="{Binding Smoke, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="高血压" FontSize="22" IsChecked="{Binding HighBP, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="糖尿病" FontSize="22" IsChecked="{Binding Tangniaobing, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="血脂异常" FontSize="22" IsChecked="{Binding Xuezhi, Mode=TwoWay}" Margin="0,0,0,10"/>
            </UniformGrid>
        </StackPanel>

        <!--既往心血管疾病-->
        <StackPanel Grid.Row="2" Margin="0,0,0,22">
            <TextBlock Text="既往心血管疾病" FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,12"/>
            <UniformGrid Columns="3">
                <CheckBox Content="冠心病" FontSize="22" IsChecked="{Binding Guanxinbing, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="脑卒中" FontSize="22" IsChecked="{Binding Naozuzhong, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="心力衰竭" FontSize="22" IsChecked="{Binding Xinlishuaijie, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="心绞痛" FontSize="22" IsChecked="{Binding Xinjiaotong, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="肾脏病" FontSize="22" IsChecked="{Binding Shenzangbing, Mode=TwoWay}" Margin="0,0,0,10"/>
                <CheckBox Content="心肌梗死" FontSize="22" IsChecked="{Binding Xinjigengsi, Mode=TwoWay}" Margin="0,0,0,10"/>
            </UniformGrid>
        </StackPanel>

        <!--疾病说明（可手工补充/修改）-->
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="疾病说明" FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,12"/>
            <TextBox
                Width="780"
                Height="90"
                FontSize="22"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"
                HorizontalAlignment="Left"
                Text="{Binding CardiovascularDIS, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!--保存 / 取消-->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button
                Width="200"
                Height="64"
                Margin="0,0,40,0"
                Click="Cancel_Click"
                Content="取消"
                FontSize="24"
                Style="{StaticResource BigBlueBtnStyle}" />
            <Button
                Width="200"
                Height="64"
                Click="Save_Click"
                Content="保存"
                FontSize="24"
                Style="{StaticResource BigBlueBtnStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="6" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="9999">
            <StackPanel hc:Growl.Token="SuccessMsg" VerticalAlignment="Top" Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Border>
