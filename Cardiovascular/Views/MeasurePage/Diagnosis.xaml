<Border x:Class="Cardio.Views.MeasurePage.Diagnosis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cardio.Views.MeasurePage"
      xmlns:r="clr-namespace:Cardio.CustomConvert"
      xmlns:c="clr-namespace:Cardio.CustomRule"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="711" 
      d:DesignWidth="1058"
      Height="700" Width="1038"
      Loaded="Border_Load"
      >

    <Border.Resources>
        <r:CheckConverter x:Key="CheckConverter" />
    </Border.Resources>
    <Border.Background>
        <ImageBrush ImageSource="/Resources/Image/Measure/医师诊断.png"  Stretch="Fill" />
    </Border.Background>
    <Border Width="1038" Height="711" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="186"/>
                <RowDefinition Height="197"/>
                <RowDefinition Height="207"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal">
                <Button Background="Transparent" Margin="60,95,0,0" Width="41" Height="30" BorderBrush="Transparent"  Click="Smoke">
                    <Image Source="{Binding ImgSelect}" Stretch="Fill"/>
                </Button>
                <Button Background="Transparent" Margin="125,95,0,0" Width="41" Height="30" BorderBrush="Transparent" Click="HighBp" >
                    <Image Source="{Binding ImgHighBP}"/>
                </Button>
                <Button Background="Transparent" Margin="140,95,0,0" Width="41" Height="30" BorderBrush="Transparent"  Name="Tangniaobing" Click="Tangniaobing_Click">
                    <Image Source="{Binding ImgTang}"/>
                </Button>
                <Button Background="Transparent" Margin="140,95,0,0" Width="41" Height="30" BorderBrush="Transparent"   Name="Xuezhiyichang"  Click="Xuezhiyichang_Click">
                    <Image Source="{Binding ImgXuezhi}"/>
                </Button>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="87"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Background="Transparent" Margin="59,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Guanxinbing">
                        <Image Source="{Binding ImgGuan}"/>
                    </Button>
                    <Button Background="Transparent" Margin="98,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Naozuzhong">
                        <Image Source="{Binding ImgNaozu}"/>
                    </Button>
                    <Button Background="Transparent" Margin="95,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Xinlishuaijie" >
                        <Image Source="{Binding ImgXinli}"/>
                    </Button>
                    <Button Background="Transparent" Margin="115,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Xinjiaotong">
                        <Image Source="{Binding ImgXinjiaotong}"/>
                    </Button>
                    <Button Background="Transparent" Margin="95,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Shenzangbing" >
                        <Image Source="{Binding ImgShenzang}"/>
                    </Button>
                    <Button Background="Transparent" Margin="95,44,0,0" Width="41" Height="30"  BorderBrush="Transparent" Click="Xinjigengsi">
                        <Image Source="{Binding ImgXinji}"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBox  Margin="0,11,160,0" Width="631" Height="41" FontSize="24">
                        <TextBox.Text>
                            <Binding UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" Path="CardiovascularDIS">
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="112"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <DatePicker x:Name="diagodate" Width="227" Height="47" Margin="260,0,0,0" FontSize="24" HorizontalAlignment="Center" SelectedDateFormat="Short" SelectedDate="{Binding DiagnosisTime}"/>
                    <ComboBox x:Name="CbDoctor" Width="227" Height="47" Margin="140,0,0,0" FontSize="24" IsEditable="True">

                    </ComboBox>
                    <Button BorderBrush="Transparent" Width="112" Height="43" Margin="10,0,0,0" Click="AddDoctor">
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Image Source="pack://application:,,,/Resources/Image/Measure/添加记忆.png" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1">
                    <TextBox Width="913" Height="93" Margin="5,0,0,19" FontSize="20" >
                        <TextBox.Text>
                            <Binding UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" Path="Doctordiagnosis">
                                
                            </Binding>
                        </TextBox.Text>

                    </TextBox>
                </Grid>
            </Grid>
            <Grid Grid.Row="4">
                <Button
                    Width="232"
                    Height="70"
                    Margin="400,0,0,10"
                    Click="Close"
                    Content="取消"
                    Style="{StaticResource BigBlueBtnStyle}" />
                <Button Width="232" Height="70" Margin="-400,0,0,10" Click="SaveDiagnosis">
                    <Button.Template>
                        <ControlTemplate>
                            <Grid>
                                <Image Source="pack://application:,,,/Resources/Image/Measure/Save.png" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>
            <ScrollViewer Grid.Row="0" Grid.RowSpan="4" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="9999" >
                <StackPanel hc:Growl.Token="SuccessMsg" VerticalAlignment="Top" Margin="0,10,10,10"/>
            </ScrollViewer>

        </Grid>
    </Border>
</Border>
