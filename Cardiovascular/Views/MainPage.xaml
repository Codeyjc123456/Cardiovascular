<Page
    x:Class="Cardio.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cardio.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="Page_Loaded"
    ShowsNavigationUI="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="BXTextBlockFont">
            <Setter Property="Control.FontFamily" Value="Times New Roman" />
            <Setter Property="Control.FontSize" Value="18" />
            <Setter Property="Control.FontWeight" Value="Bold" />
        </Style>
    </Page.Resources>
    <Page.Background>
        <ImageBrush ImageSource="/Resources/Image/Menu/主界面背景.png" Stretch="Fill" />
    </Page.Background>
    <Grid>
        <Grid.RowDefinitions>
            <!--  title 放置版本号  -->
            <RowDefinition Height="167" />
            <!--  放置主体信息  -->
            <RowDefinition Height="739" />
            <!--  放置按钮  -->
            <RowDefinition Height="174" />
        </Grid.RowDefinitions>
        <DockPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left">
            <StackPanel
                HorizontalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="1500,10,20,10"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BXTextBlockFont}"
                        Text="发布版本：" />
                    <TextBlock
                        x:Name="VersionInfo"
                        Margin="10,10,20,10"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BXTextBlockFont}"
                        Text="1" />

                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="1500,10,20,10"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BXTextBlockFont}"
                        Text="完整版本：" />
                    <TextBlock
                        x:Name="NetworkInfo"
                        Margin="10,10,20,10"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BXTextBlockFont}"
                        Text="1.0.0 20251105" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="0" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Button
                        Height="115"
                        Click="HelpBtn"
                        Content=""
                        Style="{StaticResource HelpBtnStyle}" />
                </Grid>
            </Grid>


        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="424" />
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="372" />
                <ColumnDefinition Width="399" />
                <ColumnDefinition Width="414" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="1">
                <Button
                    x:Name="MCTest"
                    Height="Auto"
                    Margin="0,0,0,0"
                    Click="OpenMeasureBtn"
                    Content=""
                    Style="{StaticResource MeasureBtnStyle}" />

            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="2"
                RenderTransformOrigin="0.5,0.358">
                <Button
                    Grid.RowSpan="4"
                    Height="Auto"
                    Margin="32,0,30,0"
                    Click="OpenDataManageBtn"
                    Content=""
                    Style="{StaticResource DataMangerBtnStyle}" />

            </Grid>

            <Grid
                Grid.Row="0"
                Grid.Column="3"
                Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="330" />
                    <RowDefinition Height="409" />
                </Grid.RowDefinitions>
                <Button
                    Grid.Row="0"
                    Height="330"
                    Margin="0,0,0,0"
                    Click="OpenUserManageBtn"
                    Content=""
                    Style="{StaticResource UserManagerBtnStyle}" />
                <Button
                    Grid.Row="1"
                    Height="382"
                    Margin="0,0,0,0"
                    Click="OpenSystemBtn"
                    Content=""
                    Style="{StaticResource SystemSettingBtnStyle}" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2">

            <Button
                Margin="0,0,40,0"
                HorizontalAlignment="Right"
                Click="QuitSoft"
                Content="退出"
                Style="{StaticResource IconBigBlueBtn}"
                Tag="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32v224c0 17.7 14.3 32 32 32s32-14.3 32-32V32zm-144.5 88.6c13.6-11.3 15.4-31.5 4.1-45.1s-31.5-15.4-45.1-4.1C49.7 115.4 16 181.8 16 256c0 132.5 107.5 240 240 240s240-107.5 240-240c0-74.2-33.8-140.6-86.6-184.6-13.6-11.3-33.8-9.4-45.1 4.1s-9.4 33.8 4.1 45.1c38.9 32.3 63.5 81 63.5 135.4 0 97.2-78.8 176-176 176s-176-78.8-176-176c0-54.4 24.7-103.1 63.5-135.4z" />

        </DockPanel>

    </Grid>

</Page>
