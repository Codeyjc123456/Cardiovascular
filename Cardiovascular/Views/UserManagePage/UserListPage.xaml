<Page
    x:Class="Cardio.Views.UserManagePage.UserListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UserListPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">

    <hc:TransitioningContentControl TransitionMode="Fade">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="100" />
                <RowDefinition Height="800" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid>
                <Image Style="{StaticResource TitleImageStyle}" />
                <Button
                    Height="72"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    Click="BackBtn"
                    Style="{StaticResource TitleBackBtnStyle}" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Rectangle Margin="30,0,10,0" Style="{StaticResource CustomSmallOrangeRectangle}" />
                <TextBlock Style="{StaticResource CustomBigTextBlock}" Text="账号/姓名：" />
                <TextBox
                    Width="400"
                    Style="{StaticResource CustomBigMedianTextBox}"
                    Text="{Binding SearchText}" />
                <Button
                    Width="180"
                    Height="60"
                    Margin="30,0,0,0"
                    Click="SerachBtn"
                    Content="搜索"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M416 208c0 45.9-14.9 88.3-40 122.7l126.6 126.7c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0s208 93.1 208 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
                <Button
                    Width="180"
                    Height="60"
                    Margin="30,0,0,0"
                    Click="RigisterBtn"
                    Content="注册"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M0 96h576c0-35.3-28.7-64-64-64H64C28.7 32 0 60.7 0 96zm0 32v288c0 35.3 28.7 64 64 64h448c35.3 0 64-28.7 64-64V128H0zm64 277.3c0-29.5 23.9-53.3 53.3-53.3h117.3c29.5 0 53.3 23.9 53.3 53.3 0 5.9-4.8 10.7-10.7 10.7H74.7c-5.9 0-10.7-4.8-10.7-10.7zM176 192a64 64 0 1 1 0 128 64 64 0 1 1 0-128zm176 16c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16z" />
                <Button
                    Width="180"
                    Height="60"
                    Margin="30,0,0,0"
                    Click="BatchRigisterBtn"
                    Content="批量注册"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M0 96h576c0-35.3-28.7-64-64-64H64C28.7 32 0 60.7 0 96zm0 32v288c0 35.3 28.7 64 64 64h448c35.3 0 64-28.7 64-64V128H0zm64 277.3c0-29.5 23.9-53.3 53.3-53.3h117.3c29.5 0 53.3 23.9 53.3 53.3 0 5.9-4.8 10.7-10.7 10.7H74.7c-5.9 0-10.7-4.8-10.7-10.7zM176 192a64 64 0 1 1 0 128 64 64 0 1 1 0-128zm176 16c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16z" />

            </StackPanel>

            <DataGrid
                x:Name="dgDataList"
                Grid.Row="2"
                Width="1920"
                Height="790"
                CellStyle="{StaticResource BigDataGridCellStyle}"
                ItemsSource="{Binding DataList}"
                ManipulationBoundaryFeedback="ManipulationBoundaryFeedback"
                RowStyle="{StaticResource BigDataGridRowStyle}"
                Style="{StaticResource BigDataGridStyle}">

                <DataGrid.ColumnHeaderStyle>
                    <Style  TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="400"
                        Binding="{Binding UserId}"
                        Header="账号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="250"
                        Binding="{Binding UserName}"
                        Header="姓名" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding UserAge}"
                        Header="年龄" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding UserSex}"
                        Header="性别" />
                    <DataGridTextColumn
                        Width="310"
                        Binding="{Binding UserBirthday}"
                        Header="出生日期" />
                    <DataGridTextColumn
                        Width="350"
                        Binding="{Binding CreateTime}"
                        Header="注册时间" />
                    <DataGridTemplateColumn
                        Width="370"
                        CanUserResize="False"
                        Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Click="OpenUpdate"
                                        Content="修改信息"
                                        Style="{StaticResource SmallBlueBtnStyle}"
                                        Tag="{Binding Id}" />
                                    <Button
                                        Click="OpenMeasure"
                                        Content="心血管测量"
                                        Style="{StaticResource SmallGreenBtnStyle}"
                                        Tag="{Binding Id}" />
                                    <Button
                                        Click="OpenDelete"
                                        Content="删除记录"
                                        Style="{StaticResource SmallRedBtnStyle}"
                                        Tag="{Binding Id}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <hc:LoadingCircle
                VerticalAlignment="Center"
                IsEnabled="False"
                Visibility="{Binding IsRunning}" />

            <StackPanel
                Grid.Row="3"
                Margin="10,20,50,10"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBlock Style="{StaticResource CustomBigTextBlock}" Text="共" />
                <TextBlock
                    Width="90"
                    Style="{StaticResource CustomBigTextBlock}"
                    Text="{Binding RecordTotal}"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,0,50,0"
                    Style="{StaticResource CustomBigTextBlock}"
                    Text="条" />
                <Button
                    Click="PageLastUpdated"
                    Content="&lt;"
                    Style="{StaticResource ChangePageBtnStyle}" />
                <TextBlock
                    Width="70"
                    Style="{StaticResource CustomBigTextBlock}"
                    Text="{Binding PageIndex}"
                    TextAlignment="Center" />
                <Button
                    Click="PageNextUpdated"
                    Content="&gt;"
                    Style="{StaticResource ChangePageBtnStyle}" />
            </StackPanel>

        </Grid>
    </hc:TransitioningContentControl>
</Page>
