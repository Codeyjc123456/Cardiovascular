<Border x:Class="Cardio.Views.StartPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="600"
        d:DesignWidth="800"
        IsVisibleChanged="Page_IsVisibleChanged"
        Loaded="Page_Loaded"
        mc:Ignorable="d">
    <Border.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Image/Menu/主界面背景.png" Stretch="Fill" />
    </Border.Background>
    <Grid Width="800" Height="600">
        <StackPanel Margin="20,500,20,20">
            <ProgressBar x:Name="CustomProgressBar" Style="{StaticResource ProgressBarSuccess}" />
            <TextBlock Margin="0,10,0,0" Foreground="White" Text="正在启动。。。" />
        </StackPanel>
    </Grid>
</Border>
