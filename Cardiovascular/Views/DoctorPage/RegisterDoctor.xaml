<Border x:Class="Cardio.Views.DoctorPage.RegisterDoctor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:c1="clr-namespace:Cardio.CustomConvert" 
        xmlns:r="clr-namespace:Cardio.CustomRule"
        d:DesignHeight="400"
        d:DesignWidth="744"
        IsVisibleChanged="Page_IsVisibleChanged"
        Loaded="Border_Loaded"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        mc:Ignorable="d">

  

    <Border.Resources>
        <c1:CheckConverter x:Key="CheckConverter" />
    </Border.Resources>
    <hc:TransitioningContentControl >
        <Border Width="744"
                Height="400"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid>
                    <hc:Card Margin="8"
                             BorderThickness="0"
                             Effect="{DynamicResource EffectShadow1}">
                        
                        <Border CornerRadius="4,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Margin="10,50,10,10"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="22"
                                               Text="姓    名：" />
                                    <TextBox x:Name="UserNameBtn"
                                             Width="400"
                                             Height="50"
                                             FontSize="18"
                                             TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding NotifyOnValidationError="True"
                                                     Path="UserID"
                                                     UpdateSourceTrigger="PropertyChanged">
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Margin="0,-10,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="Red"
                                               Text="*" />
                                </StackPanel>

                                <StackPanel Margin="10,20,10,10"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="22"
                                               Text="密    码：" />
                                    <TextBox Width="400"
                                             Height="50"
                                             FontSize="18"
                                             TextAlignment="Center"
                                             >
                                        <TextBox.Text>
                                            <Binding NotifyOnValidationError="True"
                                                     Path="UserPWD"
                                                     UpdateSourceTrigger="PropertyChanged">
                                                
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Margin="0,-10,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="Red"
                                               Text="*" />

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <hc:Card.Header>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                                <TextBlock Style="{StaticResource CustomSmallTitle}" Text="基本信息" />
                            </StackPanel>
                        </hc:Card.Header>
                      
                    </hc:Card>
                </Grid>
                <StackPanel Grid.Row="1"
                            FlowDirection="LeftToRight"
                            Orientation="Horizontal">
                    <Button Height="60"
                            Width="160"
                            Margin="40,10,10,10"
                            Click="Clear_Click" 
                            Content="返 回"
                            Style="{StaticResource IconBigBlueBtn}"
                            Tag="M48.5 224H40c-13.3 0-24-10.7-24-24V72c0-9.7 5.8-18.5 14.8-22.2S50.1 48.1 57 55l41.6 41.6c87.6-86.5 228.7-86.2 315.8 1 87.5 87.5 87.5 229.3 0 316.8s-229.3 87.5-316.8 0c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0c62.5 62.5 163.8 62.5 226.3 0s62.5-163.8 0-226.3c-62.2-62.2-162.7-62.5-225.3-1L185 183c6.9 6.9 8.9 17.2 5.2 26.2S177.7 224 168 224H48.5z"/>



                    <Button Height="60"
                            Width="160"
                            Margin="330,10,10,10"
                            Click="Commit_Click"
                            Content="保 存"
                            Style="{StaticResource IconBigBlueBtn}"
                            Tag="M64 32C28.7 32 0 60.7 0 96v320c0 35.3 28.7 64 64 64h320c35.3 0 64-28.7 64-64V173.3c0-17-6.7-33.3-18.7-45.3L352 50.7c-12-12-28.3-18.7-45.3-18.7H64zm0 96c0-17.7 14.3-32 32-32h192c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32v-64zm160 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/>
                </StackPanel>
                
                <ScrollViewer Height="Auto"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Panel.ZIndex="9999"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,10,10,10"
                                VerticalAlignment="Top"
                                hc:Growl.Token="RigisterDoctor" />
                </ScrollViewer>
            </Grid>
        </Border>
    </hc:TransitioningContentControl>
</Border>
