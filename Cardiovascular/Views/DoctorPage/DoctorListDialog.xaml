<Border x:Class="Cardio.Views.DoctorPage.DoctorListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:c="clr-namespace:Cardio.CustomConvert"
        d:DesignHeight="700"
        d:DesignWidth="1300"
        IsVisibleChanged="Page_IsVisibleChanged"
        Loaded="Border_Loaded"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        mc:Ignorable="d">

    <Border.Resources>
        <c:CheckConverter x:Key="CheckConverter" />
    </Border.Resources>

    <hc:TransitioningContentControl TransitionMode="Fade">
        <Border Width="1300"
                Height="700"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="546" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <Rectangle Style="{StaticResource CustomSmallOrangeRectangle}" />
                        <TextBlock Style="{StaticResource CustomSmallTitle}" Text="医师管理" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="dgDataList"
                          Margin="0,20,0,0"
                          Grid.Row="1"
                          CellStyle="{StaticResource MedianDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ItemsSource="{Binding DataList}"
                          RowStyle="{StaticResource MedianDataGridRowStyle}"
                          Style="{StaticResource MedianDataGridStyle}">
                   
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.5*" Binding="{Binding DoctorName}" Header="姓名" />
                        <DataGridTextColumn Width="1.5*" Binding="{Binding DoctorPwd}" Header="密码" />
                        <DataGridTemplateColumn Width="1.4*" CanUserResize="False" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Click="OpenDelete" Content="删除医师" Style="{StaticResource SmallRedBtnStyle}" Tag="{Binding Id}" />
                                        <Button Click="Default" Content="设为默认" Style="{StaticResource SmallGreenBtnStyle}" Tag="{Binding Id}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <hc:LoadingCircle Grid.Row="1" Width="50" Height="50" VerticalAlignment="Center" Visibility="{Binding IsRunning}" />
                <StackPanel Grid.Row="3" Width="1244" Margin="10,30,50,10" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Height="60"
                            Margin="40,00,10,00"
                            Click="BackBt"
                            Content="返 回"
                            Style="{StaticResource IconBigBlueBtn}"
                            Tag="M48.5 224H40c-13.3 0-24-10.7-24-24V72c0-9.7 5.8-18.5 14.8-22.2S50.1 48.1 57 55l41.6 41.6c87.6-86.5 228.7-86.2 315.8 1 87.5 87.5 87.5 229.3 0 316.8s-229.3 87.5-316.8 0c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0c62.5 62.5 163.8 62.5 226.3 0s62.5-163.8 0-226.3c-62.2-62.2-162.7-62.5-225.3-1L185 183c6.9 6.9 8.9 17.2 5.2 26.2S177.7 224 168 224H48.5z">
                        
                    </Button>
                    <Button Height="60" 
                            Margin="30,0,30,0" 
                            Click="RigisterBtn" 
                            Content="注 册"
                            Style="{StaticResource IconBigBlueBtn}"
                            Tag="M0 96h576c0-35.3-28.7-64-64-64H64C28.7 32 0 60.7 0 96zm0 32v288c0 35.3 28.7 64 64 64h448c35.3 0 64-28.7 64-64V128H0zm64 277.3c0-29.5 23.9-53.3 53.3-53.3h117.3c29.5 0 53.3 23.9 53.3 53.3 0 5.9-4.8 10.7-10.7 10.7H74.7c-5.9 0-10.7-4.8-10.7-10.7zM176 192a64 64 0 1 1 0 128 64 64 0 1 1 0-128zm176 16c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16zm0 64c0-8.8 7.2-16 16-16h128c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16z">
                    </Button>


                    <TextBlock Style="{StaticResource CustomBigTextBlock}" Margin="300 0 0 0" Text="共" />
                    <TextBlock Width="90" Style="{StaticResource CustomBigTextBlock}" Text="{Binding RecordTotal}" TextAlignment="Center" />
                    <TextBlock Margin="0,0,50,0" Style="{StaticResource CustomBigTextBlock}" Text="条" />
                    <Button Click="PageLastUpdated" Content="&lt;" Style="{StaticResource ChangePageBtnStyle}" />
                    <TextBlock Width="70" Style="{StaticResource CustomBigTextBlock}" Text="{Binding PageIndex}" TextAlignment="Center" />
                    <Button Click="PageNextUpdated" Content="&gt;" Style="{StaticResource ChangePageBtnStyle}" />
                </StackPanel>

                <ScrollViewer Height="Auto"
                              Grid.RowSpan="2"
                              Grid.Row="0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Panel.ZIndex="9999"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,10,10,10"
                                VerticalAlignment="Top"
                                hc:Growl.Token="DoctorList" />
                </ScrollViewer>
            </Grid>

        </Border>
    </hc:TransitioningContentControl>
</Border>
