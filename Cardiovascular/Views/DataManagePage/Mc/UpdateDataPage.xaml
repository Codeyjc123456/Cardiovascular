    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Cadio.CustomRule"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Cadio.Views.DataManagePage.Mc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="clr-namespace:Cardio.CustomConvert"
    Title="UpdateDataPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <hc:Interaction.Behaviors>
        <c:ValidationExceptionBehavior />
    </hc:Interaction.Behaviors>
    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Image/DataManage/hsbk.png" />
    </Page.Background>
    <Page.Resources>
        <r:CheckConverter x:Key="CheckConverter" />
    </Page.Resources>
    <hc:TransitioningContentControl TransitionStoryboard="{StaticResource FadeTransition}">
