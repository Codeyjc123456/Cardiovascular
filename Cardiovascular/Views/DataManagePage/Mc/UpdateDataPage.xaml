                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="年    龄：" />
                                    <TextBox
                                        Width="120"
                                        Height="40"
                                        Margin="20,0,0,0"
                                        FontSize="22"
                                        TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding
                                                NotifyOnValidationError="True"
                                                Path="UserAge"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <c:DataValueRule
                                                        Max="130"
                                                        Min="7"
                                                        ValidatesOnTargetUpdated="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="岁" />
                                    <TextBlock
                                        Width="110"
                                        Margin="145,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="   性    别：" />
                                    <RadioButton
                                        Margin="10,10,10,10"
                                        Content="男"
                                        FontSize="24"
                                        IsChecked="{Binding UserSex, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='男'}" />
                                    <RadioButton
                                        Margin="10,10,10,10"
                                        Content="女"
                                        FontSize="24"
                                        IsChecked="{Binding UserSex, Mode=TwoWay, Converter={StaticResource CheckConverter}, ConverterParameter='女'}" />
