            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="38" />
                <RowDefinition Height="880" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>
            <Grid>
                <Button
                    Height="72"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    Click="BackBtn">
                    <Button.Template>
                        <ControlTemplate>
                            <Grid>
                                <Image Source="pack://application:,,,/Resources/Image/Common/back.png" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Grid Grid.Row="2" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="330" />
                        <RowDefinition Height="370" />
                        <RowDefinition Height="172" />
                    </Grid.RowDefinitions>
                    <hc:Card
                        Margin="8"
                        BorderThickness="0"
                        Effect="{DynamicResource EffectShadow2}">
                        <Border Margin="0,0,0,0" CornerRadius="4,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Margin="10,20,10,5" Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="账    号：" />
                                    <TextBox
                                        Width="400"
                                        Height="40"
                                        FontSize="22"
                                        IsReadOnly="True"
                                        TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding
                                                NotifyOnValidationError="True"
                                                Path="UserID"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <c:NullRule ValidatesOnTargetUpdated="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="10,10,10,5" Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="姓    名：" />
                                    <TextBox
                                        Width="400"
                                        Height="40"
                                        FontSize="22"
                                        TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding
                                                Mode="TwoWay"
                                                NotifyOnValidationError="True"
                                                Path="UserName"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <c:NullRule ValidatesOnTargetUpdated="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="10,10,10,5" Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="身    高：" />
                                    <TextBox
                                        Width="120"
                                        Height="40"
                                        FontSize="22"
                                        TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding
                                                NotifyOnValidationError="True"
                                                Path="UserHeight"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <c:DataValueRule
                                                        Max="300"
                                                        Min="50"
                                                        RegexPattern="180"
                                                        ValidatesOnTargetUpdated="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="厘米" />
                                    <TextBlock
                                        Width="120"
                                        Margin="120,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="   体    重：" />
                                    <TextBox
                                        Width="120"
                                        FontSize="22"
                                        TextAlignment="Center">
                                        <TextBox.Text>
                                            <Binding
                                                NotifyOnValidationError="True"
                                                Path="UserWeight"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <c:DataValueRule
                                                        Max="300"
                                                        Min="30"
                                                        RegexPattern="70"
                                                        ValidatesOnTargetUpdated="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Text="千克" />
                                </StackPanel>
