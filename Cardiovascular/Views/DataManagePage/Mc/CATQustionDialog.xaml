                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="4"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=5}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="10"
                                FontSize="26"
                                Text="6.尽管我有肺部疾病，但对外出很有信心"
                                TextWrapping="Wrap" />
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="10,10,10,10"
                                    Content="0"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="4"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=5}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="10,10,10,0"
                                FontSize="26"
                                Text="7.我的睡眠非常好" />
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="10,10,10,10"
                                    Content="0"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="4"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=5}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[6], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="10,0,10,0"
                                FontSize="26"
                                Text="8.我精力旺盛" />
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="10,10,10,10"
                                    Content="0"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[7], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[7], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[7], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[7], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
