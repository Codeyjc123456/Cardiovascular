                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[7], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="COPD问卷" Style="{StaticResource TabItemsDis}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                Margin="20,30,0,0"
                                FontSize="26"
                                Text="1.您的吸烟总量？（吸烟总量=每天吸烟(包)x吸烟(年)" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="从不吸烟"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[0], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="1-15包.年"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[0], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="15-30包.年"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[0], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="大于30包.年"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[0], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="20,10,0,0"
                                FontSize="26"
                                Text="2.您的体重指数？（体重指数=体重(Kg)/身高²(m²)" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="小与18.5Kg/m²"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="18.5~23.9Kg/m²"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="24.0~27.9Kg/m²"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="大于28Kg/m²"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="20,10,0,0"
                                FontSize="26"
                                Text="3.没有感冒时您是否常有咳嗽？（吸烟总量=每天吸烟(包)x吸烟(年)" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="是"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="否"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />

                                </StackPanel>
                                <TextBlock
                                Margin="20,10,0,0"
                                FontSize="26"
                                Text="4.您平时是否感觉有气促？" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="没有气促"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[3], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="在平地急行或爬小坡时感觉气促"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[3], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="平底正常行走时感觉气促"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[3], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />

                                </StackPanel>
                                <TextBlock
                                Margin="20,10,0,0"
                                FontSize="26"
                                Text="5.您主要使用过生物燃料烹饪吗？" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="是"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="否"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[4], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />

                                </StackPanel>
                                <TextBlock
                                Margin="20,10,0,0"
                                FontSize="26"
                                Text="6.您的父母、兄弟、姐妹及子女是否有人患支气管哮喘、慢性支气管炎、肺气肿或慢阻肺？"
                                TextWrapping="Wrap" />
                                <StackPanel Margin="10,20,10,10" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="是"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="30,10,10,10"
                                    Content="否"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[5], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="MMRC问卷" Style="{StaticResource TabItemsDis}" />
                    </TabControl>
                </StackPanel>
                <!--  Card 的头部部分  -->
                <hc:Card.Header>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <!--  Card 的一级内容  -->
                        <Image Margin="0,0,10,0" Source="pack://application:,,,/Resources/Image/Common/tip_img.png" />
                        <TextBlock
                        HorizontalAlignment="Left"
                        Style="{DynamicResource TextBlockLargeBold}"
                        Text="问卷信息"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    </StackPanel>
                </hc:Card.Header>
            </hc:Card>
            <StackPanel Grid.Column="1">
                <hc:Card
                Margin="8"
                BorderThickness="0"
                Effect="{DynamicResource EffectShadow2}">
                    <!--  Card 的内容部分  -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Margin="20,10,0,10" Orientation="Horizontal">
                                <TextBlock FontSize="26" Text="账号：" />
                                <TextBox Width="280" Text="{Binding userID}" />
                            </StackPanel>
                            <StackPanel Margin="20,10,0,10" Orientation="Horizontal">
                                <TextBlock FontSize="26" Text="姓名：" />
                                <TextBox Width="280" Text="{Binding userName}" />
                            </StackPanel>
                            <StackPanel Margin="20,10,0,10" Orientation="Horizontal">
                                <TextBlock FontSize="26" Text="性别：" />
                                <TextBox Width="50" Text="{Binding userSex}" />
                            </StackPanel>
                            <StackPanel Margin="20,10,0,10" Orientation="Horizontal">
                                <TextBlock FontSize="26" Text="身高：" />
                                <TextBox Width="180" Text="{Binding userHeight}" />
                                <TextBlock
                                Margin="10,0,0,0"
                                FontSize="26"
                                Text="CM" />
                            </StackPanel>
