                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
