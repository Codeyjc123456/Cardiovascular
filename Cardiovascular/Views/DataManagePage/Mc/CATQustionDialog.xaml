                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="4"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=5}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[1], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="10"
                                FontSize="26"
                                Text="3.我没有任何胸闷的感觉" />
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="10,10,10,10"
                                    Content="0"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
