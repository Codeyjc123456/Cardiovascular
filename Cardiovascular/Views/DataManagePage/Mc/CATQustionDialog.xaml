                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="2"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=3}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="3"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=4}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="4"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=5}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="5"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[2], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=6}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                Margin="10,10,0,0"
                                FontSize="26"
                                Text="4.当我爬坡或上1层楼梯是，没有气喘的感觉"
                                TextWrapping="WrapWithOverflow" />
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                                    <RadioButton
                                    Margin="10,10,10,10"
                                    Content="0"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[3], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=1}"
                                    Style="{StaticResource SquareRadioButtonStyle}" />
                                    <RadioButton
                                    Margin="20,10,10,10"
                                    Content="1"
                                    FontSize="20"
                                    IsChecked="{Binding Answers[3], Mode=TwoWay, Converter={StaticResource checkConverter}, ConverterParameter=2}"
