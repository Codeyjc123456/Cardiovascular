<Page
    x:Class="Cardio.Views.DataManagePage.Mc.DataListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DataListPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="100" />
            <RowDefinition Height="800" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <Image Style="{StaticResource TitleImageStyle}" />
            <Button Click="BackBtn" Style="{StaticResource TitleBackBtnStyle}" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Rectangle Margin="30,0,10,0" Style="{StaticResource CustomSmallOrangeRectangle}" />
            <TextBlock Style="{StaticResource CustomBigTextBlock}" Text="账号/姓名：" />
            <TextBox
                Width="400"
                Style="{StaticResource CustomBigMedianTextBox}"
                Text="{Binding SearchText}" />
            <TextBlock
                Margin="30,0,0,0"
                Style="{StaticResource CustomBigTextBlock}"
                Text="起始时间：" />
            <DatePicker
                x:Name="StartTime"
                Width="230"
                Height="50"
                FontSize="24"
                SelectedDateFormat="Short" />
            <TextBlock
                Margin="30,0,0,0"
                Style="{StaticResource CustomBigTextBlock}"
                Text="结束时间：" />
            <DatePicker
                x:Name="EndTime"
                Width="230"
                Height="50"
                FontSize="24"
                SelectedDateFormat="Short" />
            <Button
                Click="SerachBtn"
                Content="搜   索"
                Style="{StaticResource BigGreenBtnStyle}" />
            <Button
                Click="ExportBtn"
                Content="导出Excel"
                Style="{StaticResource BigBlueBtnStyle}" />
        </StackPanel>

        <DataGrid
            x:Name="dpDataList"
            Grid.Row="2"
            CellStyle="{StaticResource BigDataGridCellStyle}"
            ItemsSource="{Binding DataList}"
            ManipulationBoundaryFeedback="ManipulationBoundaryFeedback"
            RowStyle="{StaticResource BigDataGridRowStyle}"
            Style="{StaticResource BigDataGridStyle}">

            <!--ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"-->
            <DataGrid.ColumnHeaderStyle>
                <Style  TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="0.7*"
                    Binding="{Binding userName}"
                    Header="姓名" />
                <DataGridTextColumn
                    Width="0.7*"
                    Binding="{Binding userSex}"
                    Header="性别" />
                <DataGridTextColumn
                    Width="0.7*"
                    Binding="{Binding userAge}"
                    Header="年龄" />
                <DataGridTextColumn
                    Width="0.7*"
                    Binding="{Binding userHeight}"
                    Header="身高" />
                <DataGridTextColumn
                    Width="0.7*"
                    Binding="{Binding BpHr}"
                    Header="脉率" />
                <DataGridTextColumn
                    Width="0.8*"
                    Binding="{Binding Sevr, StringFormat={}{0:N2}}"
                    Header="SEVR" />
                <DataGridTextColumn
                    Width="1.8*"
                    Binding="{Binding TestDateTime}"
                    Header="测量时间" />
                <DataGridTemplateColumn
                    Width="1.9*"
                    CanUserResize="false"
                    Header="操作">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Click="OpenReport"
                                    Content="查看报告"
                                    Style="{StaticResource SmallGreenBtnStyle}"
                                    Tag="{Binding Id}" />
                                <Button
                                    Click="OpenDelete"
                                    Content="删除记录"
                                    Style="{StaticResource SmallRedBtnStyle}"
                                    Tag="{Binding Id}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <hc:LoadingCircle
            Grid.Row="2"
            Width="50"
            Height="50"
            VerticalAlignment="Center"
            Visibility="{Binding IsRunning}" />

        <StackPanel
            Grid.Row="3"
            Margin="10,20,50,10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock Style="{StaticResource CustomBigTextBlock}" Text="共" />
            <TextBlock
                Width="90"
                Style="{StaticResource CustomBigTextBlock}"
                Text="{Binding RecordTotal}"
                TextAlignment="Center" />
            <TextBlock
                Margin="0,0,50,0"
                Style="{StaticResource CustomBigTextBlock}"
                Text="条" />
            <Button
                Click="PageLastUpdated"
                Content="&lt;"
                Style="{StaticResource ChangePageBtnStyle}" />
            <TextBlock
                Width="70"
                Style="{StaticResource CustomBigTextBlock}"
                Text="{Binding PageIndex}"
                TextAlignment="Center" />
            <Button
                Click="PageNextUpdated"
                Content="&gt;"
                Style="{StaticResource ChangePageBtnStyle}" />
        </StackPanel>

    </Grid>
</Page>
