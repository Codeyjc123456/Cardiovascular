<Page
    x:Class="Cardio.Views.DataManagePage.Mc.OpenReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fastreport="clr-namespace:FastReport.Preview;assembly=FastReport"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="OpenReportPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    IsVisibleChanged="Page_IsVisibleChanged"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CustomScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <!--  设置自定义样式  -->
            <Setter Property="Background" Value="Yellow" />
            <Setter Property="Width" Value="200" />
            <!--  设置一个较大的值来扩展宽度  -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <!--  自定义的ScrollBar模板  -->
                        <!--  ...  -->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <hc:TransitioningContentControl TransitionMode="Fade">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <Grid>
                <Image Style="{StaticResource TitleImageStyle}" />
                <Button Click="BackBtn" Style="{StaticResource TitleBackBtnStyle}" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <ScrollViewer
                    Width="1920"
                    Height="936"
                    Background="White"
                    HorizontalScrollBarVisibility="Auto"
                    ManipulationBoundaryFeedback="ManipulationBoundaryFeedback"
                    PanningMode="VerticalOnly"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel
                            Name="WaveAI"
                            Width="800"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Background="White">
                            <Border>
                                <scottplot:WpfPlot
                                    x:Name="zg_aichart"
                                    Width="800"
                                    Height="50" />
                            </Border>
                        </StackPanel>
                        <StackPanel  Panel.ZIndex="2" Background="White" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image
                                x:Name="previewControl1"
                                Width="960"
                                Source="{Binding Image1}" />
                        </StackPanel>
                    </Grid>


                </ScrollViewer>
            </StackPanel>

            <hc:LoadingCircle
                Grid.Row="1"
                VerticalAlignment="Center"
                Visibility="{Binding IsRunning}" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">

                <Button
                    Width="160"
                    Height="50"
                    Margin="30,5,30,0"
                    Click="PrintBtn"
                    Content="打 印"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M928 288H96v384h160v224h512V672h160zM704 832H320V544h384z m160-224h-96v-128H256v128h-96V352h704zM320 192h384v64h64V128H256v128h64v-64z" />

                <Button
                    x:Name="SaveBtnO"
                    Width="160"
                    Height="50"
                    Margin="30,5,30,0"
                    Click="SaveBtn"
                    Content="保 存"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M64 32C28.7 32 0 60.7 0 96v320c0 35.3 28.7 64 64 64h320c35.3 0 64-28.7 64-64V173.3c0-17-6.7-33.3-18.7-45.3L352 50.7c-12-12-28.3-18.7-45.3-18.7H64zm0 96c0-17.7 14.3-32 32-32h192c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32v-64zm160 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128z" />

                <Button
                    x:Name="Upload"
                    Width="160"
                    Height="50"
                    Margin="30,5,30,0"
                    Click="UploadBtn"
                    Content="上 传"
                    Style="{StaticResource IconBigBlueBtn}"
                    Tag="M640 364.068571v280.32a73.142857 73.142857 0 0 1-73.142857 73.142858h-109.714286a73.142857 73.142857 0 0 1-73.142857-73.142858V364.068571a18.285714 18.285714 0 0 0-18.285714-18.285714h-85.577143a36.571429 36.571429 0 0 1-27.794286-60.16L484.205714 12.8a36.571429 36.571429 0 0 1 54.857143 0L771.657143 285.622857a36.571429 36.571429 0 0 1-27.794286 60.16H658.285714a18.285714 18.285714 0 0 0-18.285714 18.285714z" />
            </StackPanel>
        </Grid>
    </hc:TransitioningContentControl>
</Page>

