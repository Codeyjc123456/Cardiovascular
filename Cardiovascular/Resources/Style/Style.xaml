        <Setter Property="Margin" Value="100,20,0,10" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontFamily" Value="Noto Sans SC Black" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="10" />
        <Setter Property="Background" Value="#2d90dc" />
        <Setter Property="BorderBrush" Value="#2d90dc" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ContentControl
                                x:Name="IconContent"
                                Margin="-10,0,0,0"
                                Content="{TemplateBinding Tag}"
                                ContentTemplate="{StaticResource GeometryTemplate}" />
                            <TextBlock Margin="25,0,0,0" Text="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  测试按钮  -->
    <Style x:Key="MeasureBtnStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
