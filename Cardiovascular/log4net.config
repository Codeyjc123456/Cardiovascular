<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<!--日志文件-->
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<!--日志文件名开头-->
		<param name="File" value="./Logs/" />
		<!--按小时滚动生成日志文件-->
		<param name="DatePattern" value="&quot;Log4-&quot;yyyy-MM-dd-HH&quot;.log&quot;" />
		<!--是否追加到文件,默认为true，通常无需设置-->
		<param name="AppendToFile" value="true" />
		<!--log保留天数，与maximumFileSize配合使用-->
		<param name="MaxSizeRollBackups" value="10" />
		<!--每个日志文件的最大大小-->
		<!--可用的单位:KB|MB|GB-->
		<!--不要使用小数,否则会一直写入当前日志-->
		<param name="MaximumFileSize" value="1MB" />
		<!--变换的形式为日期-->
		<param name="RollingStyle" value="Date" />
		<!--日志文件名是否是固定不变的-->
		<param name="StaticLogFileName" value="false" />
		<!--日志格式-->
		<layout type="log4net.Layout.PatternLayout,log4net">
			<param name="ConversionPattern" value="当前时间:%d    日志级别:%-5p    线程ID:%t%n记录位置:%c%n所在行号:%L%n日志内容:%m%n%n" />
		</layout>
	</appender>

	<root>
		<!--定义在这个级别之上的日志才会被记录-->
		<!--Highest: OFF->FATAL->RROR->WARN->INFO->DEBUG->ALL :Lowest-->
		<level value="ALL" />
		<appender-ref ref="RollingFileAppender" />
	</root>

</log4net>
